{
  "schemaVersion": 1,
  "packVersion": "1.3.0",
  "sourceRole": "framework-template",
  "upgradePolicy": "three-way-review",
  "description": "Versioned project-scoped Codex workflow files that may be deliberately adapted into copied application repositories.",
  "files": [
    { "path": "AGENTS.md", "upgradeMode": "merge", "benchmarkMode": "preserve-existing" },
    { "path": "CLAUDE.md", "upgradeMode": "replace-import", "benchmarkMode": "preserve-existing" },
    { "path": "docs/README.md", "upgradeMode": "merge", "benchmarkMode": "preserve-existing" },
    { "path": "docs/agents/workflow.md", "upgradeMode": "merge" },
    { "path": "docs/agents/verification.md", "upgradeMode": "merge" },
    { "path": "docs/agents/review-routing.md", "upgradeMode": "merge" },
    { "path": "docs/agents/code_reviewer.md", "upgradeMode": "merge" },
    { "path": "docs/agents/reviewers/agent-workflow.md", "upgradeMode": "merge" },
    { "path": "docs/agents/reviewers/consumer-contract.md", "upgradeMode": "merge" },
    { "path": "docs/agents/reviewers/performance-scale.md", "upgradeMode": "merge" },
    { "path": "docs/agents/reviewers/security-boundary.md", "upgradeMode": "merge" },
    { "path": "docs/agents/reviewers/state-integrity.md", "upgradeMode": "merge" },
    { "path": "docs/agents/mcp.md", "upgradeMode": "merge" },
    { "path": "docs/agents/tools/Normalize-TextFiles.ps1", "upgradeMode": "merge", "benchmarkMode": "preserve-existing" },
    { "path": "docs/agents/tools/Search-Repo.ps1", "upgradeMode": "merge", "benchmarkMode": "preserve-existing" },
    { "path": "docs/agents/tools/Test-AgentInstructions.ps1", "upgradeMode": "merge", "benchmarkMode": "preserve-existing" },
    { "path": "docs/prompts/README.md", "upgradeMode": "merge" },
    { "path": "docs/prompts/orchestrator.md", "upgradeMode": "merge" },
    { "path": "docs/prompts/agent_upgrade.md", "upgradeMode": "merge" },
    { "path": "docs/agents/instruction-pack.json", "upgradeMode": "replace-metadata" },
    { "path": ".codex/agents/discovery_fast.toml", "upgradeMode": "replace-profile" },
    { "path": ".codex/agents/implementation_fast.toml", "upgradeMode": "replace-profile" },
    { "path": ".codex/agents/implementation_max.toml", "upgradeMode": "replace-profile" },
    { "path": ".codex/agents/reviewer_high.toml", "upgradeMode": "replace-profile" },
    { "path": ".codex/agents/reviewer_max.toml", "upgradeMode": "replace-profile" },
    { "path": ".codex/agents/architect_max.toml", "upgradeMode": "replace-profile" }
  ],
  "preserveInCopiedApplications": [
    ".codex/config.toml",
    "docs/agents/local_instructions.md",
    "docs/agents/domain.md",
    "docs/agents/glossary.md",
    "docs/agents/heuristics.md",
    "docs/agents/tasks/",
    "docs/adr/",
    "application-specific AGENTS.md additions"
  ],
  "validation": [
    "pwsh -NoProfile -File docs/agents/tools/Test-AgentInstructions.ps1",
    "pwsh -NoProfile -File docs/agents/tools/Normalize-TextFiles.ps1 -Check <changed-pack-files>",
    "git diff --check"
  ],
  "windowsPowerShell51Fallback": [
    "powershell.exe -NoProfile -ExecutionPolicy Bypass -File docs/agents/tools/Test-AgentInstructions.ps1",
    "powershell.exe -NoProfile -ExecutionPolicy Bypass -File docs/agents/tools/Normalize-TextFiles.ps1 -Check <changed-pack-files>"
  ]
}
